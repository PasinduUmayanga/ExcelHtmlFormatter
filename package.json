{
  "name": "html-formatter",
  "private": true,
  "description": "Desktop apps that turn HTML tags inside documents into real formatting. One app per file format, built from shared packages.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=excel-formatter",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "pnpm --filter @hf/lint lint:fix",
    "format": "pnpm --filter @hf/lint format",
    "format:check": "turbo run format:check",
    "check": "turbo run lint format:check typecheck test",
    "dist": "turbo run dist",
    "dist:excel": "turbo run dist --filter=excel-formatter",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "test:ci": "turbo run test:coverage --continue -- --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
