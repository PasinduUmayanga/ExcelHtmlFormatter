{
  "name": "html-formatter",
  "private": true,
  "description": "Desktop apps that turn HTML tags inside documents into real formatting. One app per file format, built from shared packages.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=excel-formatter",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck test",
    "dist": "turbo run dist",
    "dist:excel": "turbo run dist --filter=excel-formatter"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
