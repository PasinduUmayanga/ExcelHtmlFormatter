{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["transit"],
      "outputs": ["out/**"]
    },
    "dist": {
      "dependsOn": ["build", "typecheck", "test", "^typecheck", "^test", "@hf/lint#lint"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": false
    },
    "format:check": {
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**", "test-results/**"]
    }
  }
}
